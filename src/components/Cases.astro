---
import { Image } from 'astro:assets';
import { cases, pick, ui, type Lang } from '../data/content';
import slipReview from '../assets/shots/slip-review.png';
import slipMonthly from '../assets/shots/slip-monthly.png';
import slipCategories from '../assets/shots/slip-categories.png';
import widget from '../assets/shots/usage-widget.png';
interface Props { lang: Lang }
const { lang } = Astro.props;

const t = {
  title: { ru: 'Проекты, которые доказывают', en: 'Projects that prove it' },
  lead: { ru: 'Каждый проект по одной схеме: проблема, что построил, результат и какое требование вакансии он закрывает.', en: 'Every project follows one shape: problem, what I built, result, and which vacancy requirement it covers.' },
  all: { ru: 'Все', en: 'All' },
  problem: { ru: 'Проблема', en: 'Problem' },
  built: { ru: 'Что сделал', en: 'What I built' },
  result: { ru: 'Результат', en: 'Result' },
  more: { ru: 'Подробнее', en: 'Details' },
};
const filters: [string, { ru: string; en: string }][] = [
  ['agents', { ru: 'Агенты', en: 'Agents' }],
  ['integrations', { ru: 'Интеграции', en: 'Integrations' }],
  ['pilots', { ru: 'Пилоты', en: 'Pilots' }],
  ['rag', { ru: 'RAG и поиск', en: 'RAG & search' }],
  ['documents', { ru: 'Документы', en: 'Documents' }],
];
const images: Record<string, { src: ImageMetadata; alt: { ru: string; en: string } }[]> = {
  slip: [
    { src: slipReview, alt: { ru: 'Slip: проверка распознанного чека', en: 'Slip: reviewing a recognized receipt' } },
    { src: slipMonthly, alt: { ru: 'Slip: отчёт за месяц', en: 'Slip: monthly report' } },
    { src: slipCategories, alt: { ru: 'Slip: категории расходов', en: 'Slip: spending categories' } },
  ],
  widget: [{ src: widget, alt: { ru: 'Виджет лимитов Codex по аккаунтам', en: 'Codex limits widget per account' } }],
};
---
<section class="section" id="cases">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="section-num">02</span>
      <h2>{pick(t.title, lang)}</h2>
      <p class="lead">{pick(t.lead, lang)}</p>
    </div>

    <div class="filters reveal" role="group" aria-label="filter" data-case-filters>
      <button type="button" class="chip on" data-filter="all" aria-pressed="true">{pick(t.all, lang)}</button>
      {filters.map(([k, l]) => <button type="button" class="chip" data-filter={k} aria-pressed="false">{pick(l, lang)}</button>)}
    </div>

    <div class="case-list">
      {cases.map((c, i) => (
        <details class="case card reveal" id={`case-${c.id}`} data-tags={c.tags.join(' ')} open={i === 0}>
          <summary>
            <span class="c-num mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="c-head">
              <span class="c-kicker mono">{pick(c.kicker, lang)} · {c.year}</span>
              <span class="c-title">{pick(c.title, lang)}</span>
            </span>
            <span class="c-metrics">
              {c.metrics.slice(0, 2).map((m) => (
                <span class="c-metric"><b class="mono">{m.value}</b><small>{pick(m.label, lang)}</small></span>
              ))}
            </span>
            <span class="c-toggle" aria-hidden="true"></span>
          </summary>
          <div class="c-body">
            <div class="c-text">
              <p class="c-label mono">{pick(t.problem, lang)}</p>
              <p>{pick(c.problem, lang)}</p>
              <p class="c-label mono">{pick(t.built, lang)}</p>
              <ul>{c.built.map((b) => <li>{pick(b, lang)}</li>)}</ul>
              <p class="c-label mono">{pick(t.result, lang)}</p>
              <p class="c-result">{pick(c.result, lang)}</p>
              <div class="c-stack">{c.stack.map((s) => <span class="chip">{s}</span>)}</div>
              {c.link && <a class="c-link mono" href={c.link.href} target="_blank" rel="noopener">↗ {pick(c.link.label, lang)}</a>}
            </div>
            <div class="c-visual">
              {c.diagram && (
                <ol class="flow" aria-label="flow">
                  {c.diagram.map((n, j) => <li style={`--j:${j}`}><span>{n}</span></li>)}
                </ol>
              )}
              {c.image && (
                <div class={`shots shots-${c.image}`}>
                  {images[c.image].map((im) => (
                    <Image src={im.src} alt={pick(im.alt, lang)} widths={[240, 480]} sizes="(max-width: 900px) 40vw, 220px" loading="lazy" />
                  ))}
                </div>
              )}
              <div class="c-bigmetrics">
                {c.metrics.map((m) => (
                  <div><b class="mono">{m.value}</b><small>{pick(m.label, lang)}</small></div>
                ))}
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .filters .chip { cursor: pointer; padding: 8px 14px; font-size: 13px; }
  .filters .chip.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .case-list { display: grid; gap: 14px; }
  .case { overflow: hidden; transition: border-color 0.25s; }
  .case[hidden] { display: none; }
  .case[open] { border-color: var(--line-2); }
  summary {
    list-style: none; cursor: pointer; display: grid;
    grid-template-columns: 48px 1fr auto 28px; align-items: center; gap: 18px;
    padding: 22px 24px;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .c-title { color: var(--accent); }
  .c-num { color: var(--muted); font-size: 14px; }
  .c-head { display: grid; gap: 6px; min-width: 0; }
  .c-kicker { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .c-title { font-family: var(--display); font-size: clamp(18px, 2vw, 24px); font-weight: 600; line-height: 1.2; transition: color 0.2s; }
  .c-metrics { display: flex; gap: 22px; }
  .c-metric { display: grid; text-align: right; }
  .c-metric b { font-size: 20px; color: var(--accent); }
  .c-metric small { color: var(--muted); font-size: 12px; }
  .c-toggle { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line-2); position: relative; transition: transform 0.3s, background 0.3s; }
  .c-toggle::before, .c-toggle::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; background: var(--ink); transform: translate(-50%, -50%); }
  .c-toggle::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform 0.3s; }
  .case[open] .c-toggle { background: var(--accent); border-color: var(--accent); }
  .case[open] .c-toggle::before, .case[open] .c-toggle::after { background: var(--accent-ink); }
  .case[open] .c-toggle::after { transform: translate(-50%, -50%) rotate(0deg); }

  .c-body { display: grid; grid-template-columns: 1.2fr 1fr; gap: 36px; padding: 6px 24px 28px 90px; animation: pop 0.4s cubic-bezier(.2,.7,.2,1); }
  @keyframes pop { from { opacity: 0; transform: translateY(-6px); } }
  .c-text .c-label { margin: 18px 0 6px; font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .c-text .c-label:first-child { margin-top: 0; }
  .c-text p:not(.c-label), .c-text ul { margin: 0; color: var(--ink-2); }
  .c-text ul { padding-left: 18px; display: grid; gap: 8px; }
  .c-text li::marker { color: var(--muted); }
  .c-result { color: var(--ink) !important; font-weight: 500; }
  .c-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .c-link { display: inline-block; margin-top: 16px; color: var(--accent); font-size: 13.5px; text-decoration: none; }
  .c-link:hover { text-decoration: underline; }

  .c-visual { display: grid; gap: 18px; align-content: start; }
  .flow { list-style: none; margin: 0; padding: 20px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); display: grid; gap: 10px; position: relative; }
  .flow li { position: relative; display: flex; align-items: center; gap: 12px; font-family: var(--mono); font-size: 13px; }
  .flow li::before { content: ''; width: 12px; height: 12px; border-radius: 3px; border: 1.5px solid var(--accent); background: var(--bg-2); flex: none; z-index: 1; }
  .flow li:not(:last-child)::after { content: ''; position: absolute; left: 5.25px; top: 14px; width: 1.5px; height: calc(100% + 0px); background: repeating-linear-gradient(to bottom, var(--accent) 0 4px, transparent 4px 8px); background-size: 1.5px 16px; animation: flow 1s linear infinite; }
  @keyframes flow { to { background-position: 0 16px; } }
  .flow li span { padding: 6px 10px; border-radius: 8px; background: var(--panel); border: 1px solid var(--line); }
  .case[open] .flow li span { animation: lit 4s infinite; animation-delay: calc(var(--j) * 0.6s); }
  @keyframes lit { 0%, 20% { border-color: var(--accent); color: var(--accent); } 30%, 100% { border-color: var(--line); color: inherit; } }
  .shots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .shots-widget { grid-template-columns: 1fr; max-width: 320px; }
  .shots img { width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); }
  .c-bigmetrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; }
  .c-bigmetrics div { padding: 14px; border-radius: 12px; background: var(--accent-soft); display: grid; }
  .c-bigmetrics b { font-size: 24px; }
  .c-bigmetrics small { color: var(--ink-2); font-size: 12.5px; }

  @media (max-width: 900px) {
    summary { grid-template-columns: 32px 1fr 28px; gap: 12px; padding: 18px 16px; }
    .c-metrics { display: none; }
    .c-body { grid-template-columns: 1fr; padding: 4px 16px 22px; gap: 22px; }
  }
</style>
