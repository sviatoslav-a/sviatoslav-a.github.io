---
import { hero, person, pick, type Lang } from '../data/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const trace = hero.trace[lang];
---
<section class="hero" id="top">
  <canvas class="pixels" data-pixels aria-hidden="true"></canvas>
  <div class="portrait" aria-hidden="true"><div class="portrait-ink"></div></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow reveal">{pick(hero.eyebrow, lang)}</p>
      <h1 class="reveal" data-split>{pick(hero.title, lang)}</h1>
      <p class="lead reveal">{pick(hero.lead, lang)}</p>
      <div class="cta reveal">
        <a class="btn primary" href={`https://t.me/${person.telegram}`} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 18.7 19.4c-.2 1.1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.2 13 1.4 11.5c-1-.3-1-1 .2-1.5L20.5 2.8c.9-.3 1.6.2 1.4 1.5z"/></svg>
          {pick(hero.ctaPrimary, lang)}
        </a>
        <a class="btn" href="#fit">{pick(hero.ctaSecondary, lang)} <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="terminal card reveal" data-trace aria-label="agent trace">
      <div class="term-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mono term-title">agent.run(hire)</span>
        <span class="term-status mono" data-trace-status>running</span>
      </div>
      <ol class="term-body mono">
        {trace.map(([kind, text], i) => (
          <li class={`t-${kind}`} style={`--i:${i}`} data-trace-line>
            <span class="t-kind">{kind}</span>
            <span class="t-text">{text}</span>
          </li>
        ))}
      </ol>
      <div class="term-foot mono"><span class="cursor" aria-hidden="true"></span></div>
    </div>
  </div>

  <div class="wrap stats">
    {hero.stats.map((s) => (
      <div class="stat reveal">
        <div class="stat-v mono">
          {s.prefix}<span data-count={s.value}>{s.value.toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US')}</span>{s.suffix}
        </div>
        <div class="stat-l">{pick(s.label, lang)}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; padding-top: clamp(40px, 8vw, 96px); padding-bottom: clamp(40px, 6vw, 80px); overflow: hidden; }
  .pixels { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; opacity: 0.9; }
  .portrait { position: absolute; pointer-events: none; z-index: -1; width: min(46vw, 620px); aspect-ratio: 880 / 980; top: -55px; right: max(10px, calc((100vw - 1440px) / 2 + 50px)); opacity: .4; mask-image: linear-gradient(to bottom, #000 55%, transparent 94%); }
  .portrait-ink { width: 100%; height: 100%; background: var(--ink); mask: url('/images/portrait-dark.webp') center / contain no-repeat; }
  :global([data-theme='light']) .portrait { opacity: .24; }
  :global([data-theme='light']) .portrait-ink { mask-image: url('/images/portrait-light.webp'); }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .portrait { opacity: .24; }
    :global(:root:not([data-theme='dark'])) .portrait-ink { mask-image: url('/images/portrait-light.webp'); }
  }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  h1 { font-size: clamp(38px, 6.4vw, 84px); margin-top: 22px; text-wrap: balance; }
  h1 :global(.w) { display: inline-block; opacity: 0; transform: translateY(0.4em); transition: opacity 0.6s, transform 0.6s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--d) * 45ms); }
  h1.in :global(.w) { opacity: 1; transform: none; }
  h1 :global(.w.hl) { color: var(--accent); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .terminal { align-self: end; overflow: hidden; background: color-mix(in oklab, var(--panel) 92%, transparent); }
  .term-bar { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); font-size: 13px; }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-2); }
  .dots i:first-child { background: var(--hot); }
  .term-title { color: var(--ink-2); }
  .term-status { margin-left: auto; color: var(--warn); font-size: 12px; }
  .term-status.done { color: var(--ok); }
  .term-body { list-style: none; margin: 0; padding: 18px 16px 6px; display: grid; gap: 10px; font-size: 13.5px; min-height: 250px; }
  .term-body li { display: grid; grid-template-columns: 56px 1fr; gap: 10px; opacity: 0; transform: translateX(-8px); transition: opacity 0.4s, transform 0.4s; }
  .term-body li.on { opacity: 1; transform: none; }
  .t-kind { color: var(--muted); }
  .t-goal .t-kind, .t-done .t-kind { color: var(--accent); }
  .t-tool .t-kind { color: var(--warn); }
  .t-check .t-kind { color: var(--ok); }
  .t-done .t-text { color: var(--accent); font-weight: 600; }
  .term-foot { padding: 0 16px 16px 82px; }
  .cursor { display: inline-block; width: 9px; height: 17px; background: var(--accent); animation: blink 1s steps(2) 6; vertical-align: middle; }
  @keyframes blink { 50% { opacity: 0; } }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: clamp(48px, 7vw, 88px); background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .stat { background: var(--bg-2); padding: 24px 22px; }
  .stat-v { font-size: clamp(28px, 3.4vw, 44px); font-weight: 700; color: var(--ink); letter-spacing: -0.03em; }
  .stat-l { color: var(--muted); font-size: 14px; margin-top: 6px; line-height: 1.4; }

  @media (max-width: 900px) {
    .portrait { width: 560px; top: -80px; right: -170px; opacity: .13; }
    :global([data-theme='light']) .portrait { opacity: .12; }
    .hero-grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) { .stat { padding: 18px 14px; } }
</style>
