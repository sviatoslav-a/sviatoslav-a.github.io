---
import { process, pick, type Lang } from '../data/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const n = process.steps.length;
const R = 120;
const pts = process.steps.map((_, i) => {
  const a = (i / n) * Math.PI * 2 - Math.PI / 2;
  return { x: 150 + R * Math.cos(a), y: 150 + R * Math.sin(a) };
});
---
<section class="section" id="process">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="section-num">04</span>
      <h2>{pick(process.title, lang)}</h2>
      <p class="lead">{pick(process.lead, lang)}</p>
    </div>
    <div class="proc" data-proc>
      <div class="loop reveal" aria-hidden="true">
        <svg viewBox="0 0 300 300">
          <circle cx="150" cy="150" r={R} class="track" />
          <circle cx="150" cy="150" r={R} class="spin" pathLength="100" />
          {pts.map((p, i) => (
            <g class="node" data-node={i}>
              <circle cx={p.x} cy={p.y} r="17" />
              <text x={p.x} y={p.y + 4.5} text-anchor="middle">{i + 1}</text>
            </g>
          ))}
          <text x="150" y="146" text-anchor="middle" class="center">implement</text>
          <text x="150" y="166" text-anchor="middle" class="center accent">↻ verify</text>
        </svg>
      </div>
      <ol class="steps">
        {process.steps.map((s, i) => (
          <li class="step card reveal" data-step={i}>
            <span class="s-n mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{pick(s.title, lang)}</h3>
            <p>{pick(s.text, lang)}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .proc { display: grid; grid-template-columns: 340px 1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .loop { position: sticky; top: 100px; }
  .loop svg { width: 100%; height: auto; overflow: visible; }
  .track { fill: none; stroke: var(--line); stroke-width: 2; }
  .spin { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-dasharray: 14 86; stroke-linecap: round; transform-origin: 150px 150px; animation: spin 7s linear infinite; }
  @keyframes spin { from { transform: rotate(-90deg); } to { transform: rotate(270deg); } }
  .node circle { fill: var(--panel); stroke: var(--line-2); stroke-width: 1.5; transition: fill 0.3s, stroke 0.3s; }
  .node text { font-family: var(--mono); font-size: 13px; fill: var(--ink-2); }
  .node.on circle { fill: var(--accent); stroke: var(--accent); }
  .node.on text { fill: var(--accent-ink); font-weight: 700; }
  .center { font-family: var(--mono); font-size: 14px; fill: var(--ink-2); }
  .center.accent { fill: var(--accent); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .step { padding: 22px; transition: border-color 0.3s, transform 0.3s; }
  .step.on { border-color: var(--accent); transform: translateY(-2px); }
  .s-n { color: var(--accent); font-size: 13px; }
  .step h3 { font-size: 19px; margin: 10px 0 8px; }
  .step p { margin: 0; color: var(--ink-2); font-size: 15.5px; }
  @media (max-width: 900px) { .proc { grid-template-columns: 1fr; } .loop { position: static; max-width: 260px; margin: 0 auto; } }
  @media (max-width: 600px) { .steps { grid-template-columns: 1fr; } }
</style>
