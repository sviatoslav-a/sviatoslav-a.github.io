---
import '../styles/global.css';
import { person, ui, pick, type Lang } from '../data/content';

interface Props { lang: Lang; title: string; description: string }
const { lang, title, description } = Astro.props;
const other = lang === 'ru' ? '/en/' : '/';
const base = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const nav = [
  ['fit', ui.nav.fit],
  ['cases', ui.nav.cases],
  ['pilots', ui.nav.pilots],
  ['process', ui.nav.process],
  ['path', ui.nav.path],
] as const;
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="ru" href={`${base}/`} />
    <link rel="alternate" hreflang="en" href={`${base}/en/`} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{pick(ui.skip, lang)}</a>
    <header class="topbar" data-topbar>
      <div class="wrap topbar-in">
        <a class="logo" href={lang === 'ru' ? '/' : '/en/'} aria-label={pick(person.name, lang)}>
          <span class="logo-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          <span class="logo-text">{pick(person.name, lang)}</span>
        </a>
        <nav class="nav" aria-label="Sections">
          {nav.map(([id, label]) => <a href={`#${id}`} data-nav={id}>{pick(label, lang)}</a>)}
        </nav>
        <div class="tools">
          <button class="tool search-btn" type="button" data-search-open aria-label={pick(ui.search.open, lang)}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span class="search-label">{pick(ui.search.open, lang)}</span>
            <kbd>⌘K</kbd>
          </button>
          <a class="tool" href={other} hreflang={lang === 'ru' ? 'en' : 'ru'} data-lang-switch>{pick(ui.langSwitch, lang)}</a>
          <button class="tool menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
          <button class="tool" type="button" data-theme-toggle aria-label={pick(ui.theme, lang)}>
            <svg class="i-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </div>
      </div>
      <nav class="mnav" id="mobile-nav" data-mnav hidden aria-label="Sections">
        {nav.map(([id, label]) => <a href={`#${id}`}>{pick(label, lang)}</a>)}
        <a href="#contact">{pick(ui.nav.contact, lang)}</a>
      </nav>
      <div class="progress" data-progress aria-hidden="true"></div>
    </header>

    <main id="main"><slot /></main>

    <dialog class="search" data-search aria-label={pick(ui.search.open, lang)}>
      <div class="search-box">
        <div class="search-input">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" data-search-input placeholder={pick(ui.search.placeholder, lang)} autocomplete="off" spellcheck="false" aria-label={pick(ui.search.open, lang)} />
          <kbd>esc</kbd>
        </div>
        <ul class="search-results" data-search-results role="listbox"></ul>
        <p class="search-hint">{pick(ui.search.hint, lang)}</p>
        <template data-search-empty>{pick(ui.search.empty, lang)}</template>
      </div>
    </dialog>
  </body>
</html>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px) saturate(1.4);
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .topbar.scrolled { border-bottom-color: var(--line); }
  .topbar-in { display: flex; align-items: center; gap: 20px; height: 68px; }
  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 600; white-space: nowrap; }
  .logo-mark { display: grid; grid-template-columns: repeat(3, 6px); grid-template-rows: repeat(3, 6px); gap: 2px; }
  .logo-mark i { background: var(--accent); }
  .logo-mark i:nth-child(1) { grid-area: 1 / 1 / 2 / 3; }
  .logo-mark i:nth-child(2) { grid-area: 2 / 1; }
  .logo-mark i:nth-child(3) { grid-area: 3 / 2 / 4 / 4; }
  .logo-mark i:nth-child(4) { grid-area: 1 / 3; background: var(--hot); }
  .logo-mark i:nth-child(5) { grid-area: 2 / 3; }
  .nav { display: flex; gap: 4px; margin-left: auto; }
  .nav a { text-decoration: none; color: var(--ink-2); font-size: 14.5px; padding: 8px 12px; border-radius: 999px; transition: color 0.2s, background 0.2s; }
  .nav a:hover, .nav a.active { color: var(--ink); background: var(--panel-2); }
  .tools { display: flex; gap: 8px; align-items: center; }
  .tool {
    display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 12px;
    border: 1px solid var(--line); border-radius: 999px; background: var(--panel);
    text-decoration: none; font-size: 14px; font-family: var(--mono); cursor: pointer;
  }
  .tool:hover { border-color: var(--accent); }
  .tool kbd { font-family: var(--mono); font-size: 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 5px; padding: 1px 5px; }
  :global([data-theme='light']) .i-sun, .i-moon { display: none; }
  :global([data-theme='light']) .i-moon { display: block; }
  .progress { position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
  .menu-btn { display: none; }
  .mnav { display: grid; padding: 8px var(--gutter) 16px; border-top: 1px solid var(--line); background: var(--bg); }
  .mnav[hidden] { display: none; }
  .mnav a { padding: 12px 4px; text-decoration: none; font-size: 17px; border-bottom: 1px solid var(--line); }
  .mnav a:last-child { border-bottom: 0; color: var(--accent); }
  @media (max-width: 980px) { .nav { display: none; } .tools { margin-left: auto; } .menu-btn { display: inline-flex; } }
  @media (max-width: 560px) { .search-label, .tool kbd { display: none; } .logo-text { font-size: 14px; } }

  .search {
    width: min(680px, calc(100% - 32px));
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 20px;
    background: var(--panel);
    color: var(--ink);
    box-shadow: 0 40px 120px -20px rgb(0 0 0 / 0.6);
  }
  .search::backdrop { background: rgb(5 6 8 / 0.6); backdrop-filter: blur(4px); }
  .search-input { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .search-input input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--ink); font: inherit; font-size: 17px; }
  .search-input input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .search-input kbd { font-family: var(--mono); font-size: 11px; border: 1px solid var(--line); border-radius: 5px; padding: 1px 6px; }
  .search-results { list-style: none; margin: 0; padding: 8px; max-height: min(52vh, 460px); overflow: auto; }
  .search-hint { margin: 0; padding: 12px 18px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
</style>

<style is:global>
  .search-results li a { display: grid; gap: 2px; padding: 10px 12px; border-radius: 12px; text-decoration: none; }
  .search-results li a[aria-selected='true'], .search-results li a:hover { background: var(--accent-soft); }
  .search-results .r-sec { font-family: var(--mono); font-size: 11.5px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.06em; }
  .search-results .r-title { font-weight: 600; }
  .search-results .r-snip { font-size: 14px; color: var(--ink-2); }
  .search-results mark { background: none; color: var(--accent); font-weight: 600; }
  .search-results .r-empty { padding: 18px 12px; color: var(--muted); }
</style>
