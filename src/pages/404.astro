---
import '../styles/global.css';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · Святослав Алексеев</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="wrap nf">
      <p class="mono">agent.run(find_page) → <span>404 not found</span></p>
      <h1>Такой страницы нет</h1>
      <p class="lead">This page does not exist.</p>
      <a class="btn primary" href="/">← На главную / Home</a>
    </main>
    <style>
      .nf { min-height: 100vh; display: grid; align-content: center; gap: 18px; }
      .nf .mono { color: var(--muted); }
      .nf .mono span { color: var(--hot); }
      .nf h1 { font-size: clamp(36px, 7vw, 72px); }
      .nf .btn { justify-self: start; }
    </style>
  </body>
</html>
